# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1
COMPANY_NAME="Raj Electrical Service"
DEFAULT_COMMISSION=10

# Database configuration
MONGO_URI=mongodb://localhost:27017/service-booking

# JWT secrets and expirations
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_SECRET_EXPIRES_IN=1d
ADMIN_REGISTRATION_SECRET=your_admin_registration_secret_here

# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email_here
SMTP_PASS=your_brevo_api_key_here

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay & RazorpayX Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_account_number
RAZORPAYX_KEY_ID=your_razorpayx_key_id
RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret
RAZORPAYX_WEBHOOK_SECRET=your_razorpayx_webhook_secret

# Routing & Maps (OpenRouteService)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
ORS_API_KEY=your_ors_api_key

# Firebase setup
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# Error Monitoring (Sentry)
SENTRY_DSN=your_sentry_dsn_here

